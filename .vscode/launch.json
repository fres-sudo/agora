{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agora — Local (free, offline)",
      "request": "launch",
      "type": "dart",
      "program": "apps/agora/lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--flavor",
        "dev",
        "--dart-define-from-file=${workspaceFolder}/config/local.json"
      ]
    },
